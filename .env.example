# ==============================================================================
# PAINEL DA VIDA — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Neon na Vercel)
# Fornecidas automaticamente ao conectar a integração Neon / Vercel Postgres.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SEGURANÇA E SESSÕES (Obrigatórias em Production e Preview)
# ------------------------------------------------------------------------------
# Chave mestra dedicada de 32+ caracteres para criptografia AES-256-GCM dos tokens OAuth em repouso.
# Gere uma chave com: openssl rand -base64 32
ENCRYPTION_KEY="substitua-por-uma-chave-secreta-com-pelo-menos-32-caracteres"

# Segredo do NextAuth para assinatura dos cookies de sessão JWT e HMAC do OAuth.
# Gere com: npx auth secret ou openssl rand -base64 32
AUTH_SECRET="substitua-por-um-segredo-de-sessao-gerado-com-openssl"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Google Cloud Console)
# Padrão: GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET (aliases AUTH_GOOGLE_* suportados)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"

# ------------------------------------------------------------------------------
# 4. TAREFAS AGENDADAS (Vercel Cron)
# Protege os endpoints /api/cron/* contra chamadas externas não autorizadas.
# ------------------------------------------------------------------------------
CRON_SECRET="segredo-forte-para-autorizacao-do-cron-da-vercel"

# ------------------------------------------------------------------------------
# 5. INTELIGÊNCIA ARTIFICIAL (Opcional)
# Se ausente, o sistema utiliza fallbacks determinísticos e heurísticos (regex).
# Na Vercel, o VERCEL_OIDC_TOKEN pode autenticar o AI Gateway automaticamente.
# ------------------------------------------------------------------------------
AI_GATEWAY_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"

# ------------------------------------------------------------------------------
# 6. MODO DEMONSTRAÇÃO (Apenas Development / Local)
# NUNCA ative em produção (o servidor bloqueia DEMO_MODE automaticamente em production).
# ------------------------------------------------------------------------------
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
