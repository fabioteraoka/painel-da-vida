# Use DEMO_MODE=true apenas para desenvolvimento local e demonstrações.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Obrigatório fora do modo demo. PostgreSQL compatível com Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth / NextAuth obrigatórios em produção.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Segredo usado pelos endpoints de cron da Vercel.
CRON_SECRET=
