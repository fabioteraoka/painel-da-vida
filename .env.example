# ==============================================================================
# PAINEL DA VIDA - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# --- BANCO DE DADOS (POSTGRESQL) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- AUTENTICAÇÃO DO APP (OBRIGATÓRIO PARA O LOGIN PRÓPRIO) ---
# Chave secreta de sessão (mínimo 32 caracteres gerados com: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_SECRET=

# Chave secreta de uso único para configuração da conta inicial do proprietário
# (mínimo 16 caracteres para autorizar a definição de senha do proprietário)
APP_SETUP_SECRET=
SETUP_SECRET=

# --- CHAVE DE CRIPTOGRAFIA DE TOKENS (OPCIONAL) ---
# Necessária EXCLUSIVAMENTE se integrações externas (Google/Microsoft) forem conectadas.
# Não é necessária para o login local do app. Mínimo 32 caracteres.
ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=

# --- INTEGRAÇÃO GOOGLE (OPCIONAL - GMAIL E CALENDAR) ---
# Deixe em branco se não desejar conectar Gmail e Google Calendar.
# O painel de tarefas, contas manuais e monitor de preços funciona 100% sem o Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- IA E ASSISTÊNCIA (OPCIONAL) ---
AI_GATEWAY_API_KEY=
AI_MODEL=

# --- ROTINAS E CRON ---
CRON_SECRET=

# --- MODO DEMO (APENAS EM DESENVOLVIMENTO) ---
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false