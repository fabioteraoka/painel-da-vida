# Use DEMO_MODE=true apenas para desenvolvimento local e demonstrações.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Obrigatório fora do modo demo. PostgreSQL compatível com Prisma.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# URL direta (sem pooler), usada pelo Prisma Migrate; a integração Neon na Vercel fornece DATABASE_URL_UNPOOLED.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth / NextAuth obrigatórios em produção.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Segredo usado pelos endpoints de cron da Vercel.
CRON_SECRET=

# Opcional para desenvolvimento local. Na Vercel, o AI Gateway usa autenticação OIDC automática.
AI_GATEWAY_API_KEY=
